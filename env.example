# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Yalidine API (https://yalidine.app — "Espace API" dans le compte pro)
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
YALIDINE_BASE_URL=https://api.yalidine.app/v1

# Wilaya d'expédition (id Yalidine), ex: 16 = Alger, 13 = Tlemcen
STORE_WILAYA_ID=13

# Tarifs de secours en DA, utilisés SEULEMENT si l'API Yalidine est indisponible.
# Laisser vide = la commande est refusée plutôt que facturée au mauvais prix.
FALLBACK_SHIPPING_HOME=
FALLBACK_SHIPPING_STOPDESK=

# Emails autorisés à accéder à /admin, séparés par des virgules
ADMIN_EMAILS=toi@phonehouse-maghnia.com

# URL publique du site (utilisée par le SEO : sitemap, robots, images de partage).
# Vide = le domaine .vercel.app est utilisé automatiquement. À renseigner quand le vrai domaine est branché.
NEXT_PUBLIC_SITE_URL=

# Réseaux sociaux du magasin (les icônes du footer n'apparaissent que si renseignés)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
